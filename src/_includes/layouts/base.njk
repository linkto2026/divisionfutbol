<!doctype html>
<html lang="es">
<script src="{{ '/tinacms/preview.js' | url }}" defer></script>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  {% set metaTitle = "División Fútbol" %}
  {% if title %}{% set metaTitle = title ~ " | División Fútbol" %}{% endif %}

  {% set metaDescription = site.defaultDescription %}
  {% if description %}{% set metaDescription = description %}{% endif %}
  {% if excerpt %}{% set metaDescription = excerpt %}{% endif %}

  {% set metaImage = site.defaultOgImage %}
  {% if image %}{% set metaImage = image %}{% endif %}
  {% if cover %}{% set metaImage = cover %}{% endif %}

  <title>{{ metaTitle }}</title>
  <meta name="description" content="{{ metaDescription }}">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ metaTitle }}">
  <meta property="og:description" content="{{ metaDescription }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url | url }}">
  <meta property="og:image" content="{{ site.url }}{{ metaImage | url }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ metaTitle }}">
  <meta name="twitter:description" content="{{ metaDescription }}">
  <meta name="twitter:image" content="{{ site.url }}{{ metaImage | url }}">
  <meta name="google-site-verification" content="02DLzyZ3JJqdb75aBQyiBrMiI5kEd6P2vz5BxDRIPzg" />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&family=Bebas+Neue&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{ '/css/styles.css' | url }}">
</head>

<body>
<script id="tinacms-script">
  if (window.__TINA_CMS__) {
    import('/tinacms/editor.js');
  }

</script>
<!-- TICKER -->
<div class="ticker-bar">
  <span class="ticker-label">🔴 En vivo</span>
  <div class="ticker-track" id="tickerTrack">
    <span>División Profesional Bolivia 2026 en marcha</span>
    <span>Selección Verde busca clasificación al Mundial 2026</span>
    <span>Copa Simón Bolívar — fase de grupos</span>
    <span>ACF Primera A — jornada en curso</span>
    <span>CODASUR 2026 confirmado en Sucre</span>
    <span>División Profesional Bolivia 2026 en marcha</span>
    <span>Selección Verde busca clasificación al Mundial 2026</span>
    <span>Copa Simón Bolívar — fase de grupos</span>
    <span>ACF Primera A — jornada en curso</span>
    <span>CODASUR 2026 confirmado en Sucre</span>
  </div>
</div>

<header class="header">
  <div class="header-inner">
    <a class="brand" href="{{ '/' | url }}">
      DIVISIÓN FÚTBOL<span class="brand-dot"></span>
    </a>

    <nav class="nav">
      <a href="{{ '/' | url }}">Inicio</a>
      <a href="{{ '/categoria/seleccion/' | url }}">Selección</a>
      <a href="{{ '/categoria/division-profesional/' | url }}">Div Pro</a>
      <a href="{{ '/categoria/copa-simon-bolivar/' | url }}">Simón Bolívar</a>

      <details class="nav-drop">
        <summary>ACF</summary>
        <div class="nav-drop-menu">
          <a href="{{ '/categoria/acf-primera-a/' | url }}">Primera A</a>
          <a href="{{ '/categoria/acf-primera-b/' | url }}">Primera B</a>
          <a href="{{ '/categoria/acf-ascensos/' | url }}">Ascensos</a>
        </div>
      </details>

      <a href="{{ '/categoria/internacional/' | url }}">Internacional</a>
      <a href="{{ '/categoria/automovilismo/' | url }}">Automovilismo</a>
      <a href="{{ '/categoria/otros-deportes/' | url }}">Otros</a>
    </nav>
  </div>
</header>

<main class="container">
  {{ content | safe }}
</main>

{% include "footer.njk" %}

</body>
</html>
